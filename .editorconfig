# EditorConfig helps maintain consistent coding styles across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,cfg,ini}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.py]
max_line_length = 100

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,ico,webp,pt,onnx,engine,mp4}]
insert_final_newline = false
trim_trailing_whitespace = false
